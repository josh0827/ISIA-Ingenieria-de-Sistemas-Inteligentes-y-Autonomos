# Copia este archivo a .env.local y completa los valores con tu proyecto de Firebase.
# .env.local ya está excluido de git (ver .gitignore); nunca lo subas al repositorio.

# --- Configuración pública del cliente (Firebase Web App) ---
# Proyecto de Firebase → Configuración del proyecto → Tus apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Credenciales del servidor (Admin SDK) ---
# Proyecto de Firebase → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pega la clave privada completa, con los "\n" literales (entre comillas, en una sola línea).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
