# Copia este archivo como .env.local y reemplaza cada marcador.
# Nunca guardes credenciales reales en este archivo ni en Git.

# Firebase Web App: configuración pública utilizada por Authentication.
NEXT_PUBLIC_FIREBASE_API_KEY=TU_API_KEY_AQUI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=TU_AUTH_DOMAIN_AQUI
NEXT_PUBLIC_FIREBASE_PROJECT_ID=TU_PROJECT_ID_AQUI
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=TU_MESSAGING_SENDER_ID_AQUI
NEXT_PUBLIC_FIREBASE_APP_ID=TU_APP_ID_AQUI

# Firebase Admin SDK: credenciales privadas exclusivas del servidor.
FIREBASE_PROJECT_ID=TU_PROJECT_ID_AQUI
FIREBASE_CLIENT_EMAIL=TU_CLIENT_EMAIL_AQUI
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY_AQUI\n-----END PRIVATE KEY-----\n"

# Vercel Blob: se inyecta automáticamente al vincular un Blob Store en Vercel.
# Solo se necesita en Vercel; el entorno local guarda archivos en public/imagenes/.
BLOB_READ_WRITE_TOKEN=TU_BLOB_READ_WRITE_TOKEN_AQUI
