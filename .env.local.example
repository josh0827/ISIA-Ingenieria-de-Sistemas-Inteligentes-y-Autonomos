# Copia este archivo como .env.local y reemplaza cada marcador.
# Nunca guardes credenciales reales en este archivo ni en Git.

# Supabase: URL y clave pública para Auth SSR.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Formato sb_publishable_... (puede ir en el navegador).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# URL pública del entorno. En producción debe usar HTTPS y no terminar en /.
NEXT_PUBLIC_SITE_URL=https://isia-ingenieria-de-sistemas-intelig.vercel.app

# Exclusiva del servidor. Nunca uses NEXT_PUBLIC_ ni la expongas al navegador.
# Formato sb_secret_... (solo servidor, scripts y CI privados).
SUPABASE_SECRET_KEY=sb_secret_xxxxx
